<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>leaderfall: suite {{ s.tag }}</title>
<style>{{ css }}</style>
</head>
<body>
<h1>leaderfall suite <code>{{ s.tag }}</code> <span class="badge {{ 'pass' if s.passed else 'fail' }}">{{ 'pass' if s.passed else 'FAIL' }}</span></h1>
<p class="sub">{{ s.started_at }} → {{ s.finished_at }} · {{ s.rows|length }} scenarios · {{ s.rows|selectattr('passed')|list|length }} passed<br>
{% for k, v in s.versions.items() %}{{ k }} {{ v }} · {% endfor %}host {{ s.host.get('platform') }}, {{ s.host.get('cpus') }} CPUs</p>

<table>
<tr><th>scenario</th><th>profile / sync</th><th>result</th><th class="num">detection</th><th class="num">RTO write</th><th class="num">stall</th><th class="num">read-only</th><th class="num">RTO read</th><th class="num">lost</th><th class="num">unknown</th><th>split brain</th><th class="num">fenced</th><th class="num">rejoin</th><th>failed checks</th></tr>
{% for row in s.rows %}
<tr>
<td><a href="{{ links[row.scenario] }}">{{ row.scenario }}</a></td>
<td>{{ row.profile }} / {{ row.sync }}</td>
<td class="{{ 'pass' if row.passed else 'fail' }}">{{ 'pass' if row.passed else 'FAIL' }}</td>
<td class="num">{{ fmt(row.detection_sec) }}</td>
<td class="num">{{ fmt(row.rto_write_sec) }}</td>
<td class="num">{{ fmt(row.ack_gap_sec) }}</td>
<td class="num">{{ fmt(row.readonly_window_sec) }}</td>
<td class="num">{{ fmt(row.rto_read_sec) }}</td>
<td class="num {{ 'fail' if row.lost_acked_commits else '' }}">{{ row.lost_acked_commits }}</td>
<td class="num">{{ row.unknown_commits }}</td>
<td class="{{ 'fail' if row.split_brain else '' }}">{{ 'yes' if row.split_brain else 'no' }}</td>
<td class="num">{{ fmt(row.demotion_sec) }}</td>
<td class="num">{{ fmt(row.rejoin_sec) }}</td>
<td>{{ row.failed_checks|join(', ') }}{% if row.error %} <span class="fail">({{ row.error }})</span>{% endif %}</td>
</tr>
{% endfor %}
</table>

<p class="sub">detection: fault → Patroni shows a new leader · RTO write: fault → first acked write · stall: longest gap between two acked writes · read-only: writes that reached a node still in recovery · lost: acked commits missing on the final primary · fenced: fault → old primary stops taking writes · rejoin: recovery action → streaming with lag 0. Times in seconds.</p>

<footer>Generated by leaderfall. Each scenario links to its own report with the timeline, SLO checks and raw data.</footer>
</body>
</html>
