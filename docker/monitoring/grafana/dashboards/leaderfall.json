{
  "uid": "leaderfall",
  "title": "Leaderfall: PostgreSQL HA cluster",
  "tags": [
    "leaderfall"
  ],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "leaderfall faults",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "Role per node (green = primary, blue = replica, red = down)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "patroni_primary * 2 + patroni_replica",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down / unknown",
                  "color": "dark-red"
                },
                "1": {
                  "text": "replica",
                  "color": "blue"
                },
                "2": {
                  "text": "primary",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL timeline",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "patroni_postgres_timeline",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Replication lag (bytes behind the leader)",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(max(patroni_xlog_location) - on() group_right() patroni_xlog_replayed_location, 0)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "title": "HAProxy backend servers (green = UP, red = DOWN)",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "haproxy_server_status{proxy=~\"primary|replicas\", state=\"UP\"}",
          "legendFormat": "{{proxy}}/{{server}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "dark-red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Write connections through HAProxy (:5000)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(haproxy_frontend_connections_total{proxy=\"writes\"}[10s])",
          "legendFormat": "new connections/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "etcd leader changes and quorum",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "etcd_server_has_leader",
          "legendFormat": "{{instance}} has leader",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(etcd_server_leader_changes_seen_total[1m])",
          "legendFormat": "{{instance}} leader changes (1m)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
